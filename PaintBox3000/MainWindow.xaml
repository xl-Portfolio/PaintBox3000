<Window x:Class="PaintBox3000.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaintBox3000"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="PaintBox3000" Height="720" Width="1280">

    <Window.Resources>
        <SolidColorBrush x:Key="BaGr1" Color="Black"/>
        <SolidColorBrush x:Key="FoGr1" Color="White"/>
        <FontFamily x:Key="Font1">Cascadia Code</FontFamily>
        <sys:Double x:Key="FontSize1">12</sys:Double>
        <sys:Double x:Key="Fontsize2">8</sys:Double>
        <FontStretch x:Key="Stretch1">Expanded</FontStretch>

        <Style x:Key="BaseStyle" TargetType="Control">
            <Setter Property="Background" Value="{StaticResource BaGr1}"/>
            <Setter Property="Foreground" Value="{StaticResource FoGr1}"/>
            <Setter Property="FontFamily" Value="{StaticResource Font1}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
            <Setter Property="FontStretch" Value="{StaticResource Stretch1}"/>
        </Style>
        <Style TargetType="Menu" BasedOn="{StaticResource BaseStyle}"/>
        <Style TargetType="MenuItem" BasedOn="{StaticResource BaseStyle}"/>
        <Style TargetType="ToolBar" BasedOn="{StaticResource BaseStyle}"/>
        <Style TargetType="StatusBar" BasedOn="{StaticResource BaseStyle}"/>
        <Style x:Key="LblStatusBar" TargetType="Label" BasedOn="{StaticResource BaseStyle}">
            <Setter Property="FontSize" Value="{StaticResource Fontsize2}"/>
        </Style>
        <Style x:Key="LblToolBar" TargetType="Label" BasedOn="{StaticResource BaseStyle}">
            <Setter Property="FontSize" Value="{StaticResource Fontsize2}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BaseStyle}"/>
        <Style TargetType="TabPanel" BasedOn="{StaticResource BaseStyle}"/>
    </Window.Resources>
    
    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MenuToolbarRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusBarRow" Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Border1Col" Width="Auto"/>
            <ColumnDefinition x:Name="CanvasCol" Width="*"/>
            <ColumnDefinition x:Name="Splitter" Width="Auto"/>
            <ColumnDefinition x:Name="SiedeBarCol" Width="250"/>
            <ColumnDefinition x:Name="Border2Col" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" VerticalAlignment="Top" Orientation="Vertical">
            <Menu x:Name="MenuBar" MinHeight="20" MinWidth="50">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open"/>
                    <MenuItem Header="_Save"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
            </Menu>
            <ToolBarTray Background="{StaticResource BaGr1}" MinHeight="20">
                <ToolBar x:Name="ToolBarUndo">
                    <ToolBar.Resources>
                        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource BaseStyle}"/>
                    </ToolBar.Resources>
                    <Button x:Name="ClearBtn" Content="Clear" Click="OnClickClear"/>
                    <Button x:Name="UndoBtn" Content="Undo" Click="OnClickUndo"/>
                    <Button x:Name="RedoBtn" Content="Redo" Click="OnClickRedo"/>
                </ToolBar>
                <ToolBar x:Name="ToolBarShapes">
                    <ToolBar.Resources>
                        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource BaseStyle}"/>
                    </ToolBar.Resources>
                    <Button Content="Line" Click="OnPaintLine" />
                    <Button Content="Rectangle" Click="OnPaintRectangle" />
                    <Button Content="Ellipse" Click="OnPaintEllipse" />
                    <Button Content="Freehand" Click="OnPaintFreehand" />
                </ToolBar>
                <ToolBar x:Name="ToolBarColors">
                    <ToolBar.Resources>
                        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource BaseStyle}"/>
                    </ToolBar.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Content="history" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource LblToolBar}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0" Width="17" Height="17" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Width="17" Height="17" />
                    </Grid>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>
        
        <Border Width="5" Grid.Column="0" Grid.Row="1" Background="{StaticResource BaGr1}"/>
        
        <Canvas x:Name="Canvas" Grid.Row="1" Grid.Column="1" Margin="0" Background="White" MouseLeftButtonDown="OnPressed" MouseMove="OnMoved" 
                MouseLeftButtonUp="OnReleased"/>

        <GridSplitter Grid.Row="1" Grid.Column="2" Width="5" ResizeBehavior="PreviousAndNext" Background="{StaticResource BaGr1}"/>
        <DockPanel x:Name="SideBar" Grid.Row="1" Grid.Column="3" >
            <Grid DockPanel.Dock="Top" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SideBarTop" Grid.ColumnSpan="2" Height="25" Background="{StaticResource BaGr1}"/>
                <Label x:Name="SideBarHeader" Grid.Column="0" HorizontalAlignment="Left" Content="settings" Style="{StaticResource LblToolBar}"/>
                <Button x:Name="BtnCloseSideBar" Grid.Column="1" HorizontalAlignment="Right" Height="15" Width="15" Background="White" Foreground="Black" Content="✕" 
                        Padding="1,1,1,1" Margin="3" FontSize="{StaticResource Fontsize2}" FontWeight="Bold" Click="OnCloseSidebar"/>
            </Grid>
            <Grid x:Name="BrushConfig" DockPanel.Dock="Right" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,5" >
                    <Label Content="brush" Padding="2,2,2,0"/>
                    <Label Content="pt" HorizontalAlignment="Center" Padding="2,0,2,2" Target="{Binding ElementName=brushSlider}"/>
                </StackPanel>
                <Slider x:Name="brushSlider" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Minimum="1" Maximum="100" 
                        TickFrequency="5" TickPlacement="BottomRight" LargeChange="5" 
                        AutoToolTipPlacement="TopLeft" ValueChanged="OnBrushSizeChanged"/>
                <StackPanel Orientation="Vertical" Grid.Row="2"  Margin="0,5,0,5">
                    <Label Content="tip" HorizontalAlignment="Center" Target="{Binding ElementName=brushForm}"/>
                    <RadioButton x:Name="radioRound" GroupName="brushShape" HorizontalAlignment="Center" >r</RadioButton>
                    <RadioButton x:Name="radioSquare" GroupName="brushShape" HorizontalAlignment="Center" >s</RadioButton>
                </StackPanel>
            </Grid>

            <TabControl>
                <TabItem Header="Stroke">
                    <ListBox x:Name="strokeColorList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                            ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnStrokeColorChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Fill="{Binding Path=Name}" Width="17" Height="17" ToolTip="{Binding Path=Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="Fill">
                    <ListBox x:Name="fillColorList" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                            ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnFillColorChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Fill="{Binding Path=Name}" Width="17" Height="17" ToolTip="{Binding Path=MemberType}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </DockPanel>

        <StatusBar x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="4" Height="25" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="tool: " Style="{StaticResource LblStatusBar}"/>
                    <Label x:Name="LblSBTool" Style="{StaticResource LblStatusBar}"   Margin="0,0,50,0"/>
                    <Label x:Name="LblStatStrokeThickness" Style="{StaticResource LblStatusBar}"/>
                    <Label Content="3p" Margin="0,0,50,0" Style="{StaticResource LblStatusBar}"/>
                    <Label Content="stroke:" Style="{StaticResource LblStatusBar}"/>
                    <Label x:Name="LblSBStrokeColor" Style="{StaticResource LblStatusBar}"/>
                    <Label Content="fill:" Style="{StaticResource LblStatusBar}"/>
                    <Label x:Name="LblSBFillColor" Style="{StaticResource LblStatusBar}"/>
            </StackPanel>
        </StatusBar>
    </Grid>
</Window>

